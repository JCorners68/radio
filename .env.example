# Optional external env file to chain-load (e.g. shared cloud credentials)
# RADIO_ENV_FILE=/path/to/.env.production

# Google Cloud / Vertex AI (required for Gemini track discovery & AI Builder)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Optional local OpenAI-compatible LLM endpoint for the Find page
# QWEN_URL=http://localhost:8000/v1
# QWEN_MODEL=qwen3.8-27b

# Optional passcode gate for remote tunnel access (localhost always bypasses)
# RADIO_PASSCODE=change-me
# RADIO_COOKIE_SECRET=optional-hmac-secret
